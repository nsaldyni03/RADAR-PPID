# GEMINI_API_KEY: Kunci API Gemini untuk pemanggilan dari sisi server (diatur melalui panel Secrets).
GEMINI_API_KEY=

# GEMINI_MODEL: Nama model Gemini yang digunakan di server (opsional, default seri Flash: gemini-4-hydrogen).
GEMINI_MODEL=

# APP_URL: URL aplikasi saat dijalankan di lingkungan hosting.
APP_URL=
